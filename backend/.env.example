# JourneyMate backend (example only — copy to backend/.env locally, never commit secrets)

NODE_ENV=development
PORT=8080

# Database (use DATABASE_URL in cloud, or PG* locally)
# DATABASE_URL=postgres://user:pass@host:5432/journeymate
PGHOST=localhost
PGPORT=5432
PGDATABASE=journeymate
PGUSER=postgres
PGPASSWORD=change-me
PGPOOL_MAX=10

# Auth
AUTH_SECRET=change-me-to-a-long-random-string
TOKEN_TTL_MS=604800000

# CORS (comma-separated in production)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# Google (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI / LLM (OpenAI Chat Completions compatible endpoint)
# Your code calls POST to AI_API_URL with an Authorization: Bearer <AI_API_KEY> header.
#
# Option A — OpenAI (paid / usage-based)
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini
# AI_API_URL=https://api.openai.com/v1/chat/completions
#
# Option B — Groq (often easiest free-credit / fast free tier) — still OpenAI-compatible
# - Create a free key in Groq console, then:
# AI_API_KEY=<GROQ_API_KEY>
# AI_MODEL=llama-3.1-8b-instant
# AI_API_URL=https://api.groq.com/openai/v1/chat/completions
#
# Option C — Together (OpenAI-compatible) — may offer free credits
# AI_API_KEY=<TOGETHER_API_KEY>
# AI_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo
# AI_API_URL=https://api.together.xyz/v1/chat/completions
#
# Option D — local Ollama (dev machine) — OpenAI compatible server
# AI_API_KEY=not-needed
# AI_MODEL=llama3.1
# AI_API_URL=http://host.docker.internal:11434/v1/chat/completions

AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_TIMEOUT_MS=20000

# Realtime enrichment used by the AI service (geocoding + weather, etc.)
AI_REALTIME_ENABLED=true
AI_LIVE_TIMEOUT_MS=8000

# Boot behaviour
SEED_ON_BOOT=true
TRUST_PROXY=true
RATE_LIMIT_MAX=300
