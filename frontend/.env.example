# Copy to .env.local for local dev. On Vercel, set the same keys in Project → Settings → Environment Variables.

# Required for production: full URL of your deployed API (must end with /api — same path Express uses).
# Example: https://journeymate-api.vercel.app/api
VITE_API_URL=

# Optional: Google Sign-In / Maps (see Google Cloud Console)
# VITE_GOOGLE_CLIENT_ID=
# VITE_GOOGLE_MAPS_API_KEY=
